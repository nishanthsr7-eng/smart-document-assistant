# Copy to .env and fill in. Never commit .env.

# Which model generates answers: gemini (default), groq, or ollama (offline fallback).
LLM_PROVIDER=gemini

# Google Gemini (default). Free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (optional, fastest). Free tier key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama offline fallback (LLM_PROVIDER=ollama). Project-scoped server, not the system default.
OLLAMA_HOST=127.0.0.1:11435
OLLAMA_MODEL=qwen3:8b

# Optional. Only needed for gated HF models or to avoid anonymous rate limits.
HF_TOKEN=
