# Generation provider: gemini (default), groq, ollama (offline fallback), or none
# (retrieval only -- no key, no generation; used by the CI eval gate).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_HOST=127.0.0.1:11435
OLLAMA_MODEL=qwen3:8b

# Ordered failover chain tried after LLM_PROVIDER, e.g. "groq,ollama". Empty means no failover.
# A provider is skipped once LLM_BREAKER_FAILURES consecutive calls fail, and one probe is let
# through after the cooldown.
LLM_FALLBACK_CHAIN=
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_S=60

# Embedding and reranking on a HuggingFace TEI service instead of in this process. Empty means
# in-process weights. `docker compose --profile tei up -d` serves both on the ports below.
TEI_EMBED_URL=
TEI_RERANK_URL=
TEI_TIMEOUT_S=60
TEI_MAX_CONNECTIONS=16

# Shared state. All required -- the service has no process-local fallback.
# Defaults match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://sda:sda@127.0.0.1:5433/sda
REDIS_URL=redis://127.0.0.1:6380/0
S3_ENDPOINT=http://127.0.0.1:9002
S3_BUCKET=sda-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10

# Ingest worker: jobs processed concurrently per worker process (CPU-bound, keep low).
INGEST_CONCURRENCY=1

# Concurrent answers per API process. Each one holds a thread through reranking and generation,
# so this bounds CPU; past it /query returns 503 rather than queueing. The timeout is the hard
# wall-clock life of one answer, after which it is cancelled and the caller is told.
QUERY_CONCURRENCY=8
QUERY_TIMEOUT_S=180

# Collection pages. A caller asking for more than the cap gets the cap, not an error; to read
# everything, follow next_cursor. An Idempotency-Key is replayable for this long.
API_PAGE_SIZE=50
API_MAX_PAGE_SIZE=200
IDEMPOTENCY_TTL_S=86400
MAX_BULK_FILES=10

# Deployment-wide operations -- reindex, cutover, rollback, the retention sweep -- act on every
# tenant, so they need a deployment-level credential on top of an admin token. Unset disables
# those endpoints rather than opening them.
OPERATOR_TOKEN=

# Retention. A delete stops being answerable immediately and stops being recoverable after
# RETENTION_SOFT_DELETE_DAYS; the gap between those two dates is the whole point. The old index
# window is the rollback window for a reindex: once those chunks are swept, undoing a cutover
# means another rebuild. 0 on any of these means "keep forever".
RETENTION_ENABLED=1
RETENTION_SOFT_DELETE_DAYS=30
RETENTION_SUPERSEDED_DAYS=30
RETENTION_OLD_INDEX_DAYS=7
RETENTION_AUDIT_DAYS=0

# Ingest-completion callbacks, signed with a per-subscription secret. A webhook URL is
# caller-controlled input this service then fetches, so a private address is refused unless
# you are running a receiver on loopback in development. A run of failures disables the
# subscription rather than costing every ingest a timeout forever.
WEBHOOKS_ENABLED=1
WEBHOOKS_MAX_PER_TENANT=5
WEBHOOK_TIMEOUT_S=5
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BACKOFF_S=1
WEBHOOK_MAX_FAILURES=20
WEBHOOK_ALLOW_PRIVATE_TARGETS=0

# Per-tenant rate limits (token buckets in Redis, shared by every replica) and daily spend
# budgets. Rates are sustained per minute; the burst is how far ahead a tenant may run. Auth is
# limited by client address instead, since the caller has no token yet. Budgets of 0 are off;
# spend is metered after each generation, so a budget is crossed by at most one answer.
RATE_LIMIT_ENABLED=1
QUERY_RATE_PER_MINUTE=30
QUERY_BURST=10
INGEST_RATE_PER_MINUTE=6
INGEST_BURST=3
AUTH_RATE_PER_MINUTE=10
AUTH_BURST=5
DAILY_TOKEN_QUOTA=0
DAILY_COST_USD=0

# OCR for PDFs with no text layer (RapidOCR, ~9s per page on a CPU). 0 rejects scanned uploads.
OCR_ENABLED=1
OCR_MAX_PAGES=50

# Auth: HS256 signing key for access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_S=43200

# Comma-separated addresses allowed to hold the admin role. Everyone else signs up as editor.
ADMIN_EMAILS=nishanth.97872@gmail.com

# Observability. Every exporter is opt-in: unset means spans and metrics stay in-process.
DEPLOY_ENV=development
LOG_JSON=1
LOG_LEVEL=INFO
# OTLP/HTTP base URL of a collector or Jaeger (docker compose --profile obs up -d):
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sda
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_DB_SPANS=1
# Bearer token for GET /metrics. Empty leaves the scrape endpoint open.
METRICS_TOKEN=
WORKER_METRICS_PORT=9100
# Langfuse: prompt, context, usage and cost per query. https://cloud.langfuse.com or self-hosted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Override generation pricing without a deploy: {"model": [usd_per_mtok_in, usd_per_mtok_out]}
MODEL_PRICING_JSON=

# Runtime decision thresholds live in config/thresholds/<version>.yaml, not in source. Select the
# version a deploy runs here; a retune is then a rollout and a rollback. Overrides are dotted
# paths into the selected artifact, validated against the same schema, e.g.
#   THRESHOLD_OVERRIDES_JSON={"trust.abstain_threshold": 0.35}
# Every value is folded into the answer cache key, so a change cannot serve stale answers on.
THRESHOLDS_VERSION=v1
THRESHOLD_OVERRIDES_JSON=

# Browser-facing and egress defences.
# Origins allowed to call this API, comma separated. "*" is rejected: the API allows credentials.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# connect-src for the SPA's CSP. Widen when the API is on a different origin than the SPA.
CSP_CONNECT_SRC='self'
# Strict-Transport-Security max-age. 0 omits the header; only set it behind TLS.
HSTS_MAX_AGE_S=0
# Mark retrieved passages as data in the prompt (the document side of injection defence).
SPOTLIGHT_DOCUMENTS=1
# Check the generated answer for a leaked system prompt or an injected link before returning it.
SCAN_OUTPUT=1
# Mask emails, phone numbers and government identifiers in logs, traces and prompt captures.
REDACT_PII=1
# Refuse to start if any configured exporter or provider would send text off this box.
NO_EGRESS=0

# --- Frontend build-time settings (Vite inlines these; they are not read at runtime) ---
# With neither DSN nor endpoint set, the SPA ships neither SDK: the error tracker is a dynamic
# import behind the DSN check, so the bundler drops it. VITE_RELEASE should be the same release
# string the backend reports, so a browser error and its request join on it.
VITE_SENTRY_DSN=
VITE_ANALYTICS_ENDPOINT=
VITE_RELEASE=dev
VITE_DEPLOY_ENV=development
