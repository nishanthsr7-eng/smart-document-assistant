# Generation provider: gemini (default), groq, ollama (offline fallback), or none
# (retrieval only -- no key, no generation; used by the CI eval gate).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_HOST=127.0.0.1:11435
OLLAMA_MODEL=qwen3:8b

# Embedding and reranking on a HuggingFace TEI service instead of in this process. Empty means
# in-process weights. `docker compose --profile tei up -d` serves both on the ports below.
TEI_EMBED_URL=
TEI_RERANK_URL=
TEI_TIMEOUT_S=60
TEI_MAX_CONNECTIONS=16

# Shared state. All required -- the service has no process-local fallback.
# Defaults match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://sda:sda@127.0.0.1:5433/sda
REDIS_URL=redis://127.0.0.1:6380/0
S3_ENDPOINT=http://127.0.0.1:9002
S3_BUCKET=sda-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10

# Ingest worker: jobs processed concurrently per worker process (CPU-bound, keep low).
INGEST_CONCURRENCY=1

# Auth: HS256 signing key for access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_S=43200

# Observability. Every exporter is opt-in: unset means spans and metrics stay in-process.
DEPLOY_ENV=development
LOG_JSON=1
LOG_LEVEL=INFO
# OTLP/HTTP base URL of a collector or Jaeger (docker compose --profile obs up -d):
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sda
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_DB_SPANS=1
# Bearer token for GET /metrics. Empty leaves the scrape endpoint open.
METRICS_TOKEN=
WORKER_METRICS_PORT=9100
# Langfuse: prompt, context, usage and cost per query. https://cloud.langfuse.com or self-hosted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Override generation pricing without a deploy: {"model": [usd_per_mtok_in, usd_per_mtok_out]}
MODEL_PRICING_JSON=
