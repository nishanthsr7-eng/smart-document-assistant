graph TB
    QV["Query variants<br/>raw + 3 expansions"] --> D["Dense: ChromaDB cosine<br/>doc_id filter, k=30 each"]
    QT["Query tokens<br/>stopword-filtered"] --> L["Lexical: BM25Okapi<br/>k=30"]

    D --> M["merge_dense<br/>keep best cosine per chunk_id"]
    M --> F["RRF score = sum of 1 / k + rank<br/>k = 60"]
    L --> F

    F --> CON{"Do dense and lexical<br/>agree in the top 2?"}
    CON -->|"yes"| FLAG["retrieval_consensus = true<br/>can override a soft abstain"]
    CON -->|"no"| NOFLAG["retrieval_consensus = false"]

    F --> TOP["Top 10 fused"]
    TOP --> CE["Cross-encoder<br/>mxbai-rerank-base<br/>scores query x chunk directly"]
    CE --> OUT["Ranked hits<br/>top_score, top1-top2 margin"]

    NOTE["Why both: dense catches paraphrase,<br/>BM25 catches exact identifiers, codes,<br/>rare terms that embeddings blur.<br/>The cross-encoder then reads each<br/>pair jointly instead of comparing vectors."]
    CE -.-> NOTE
